# Beaver Agent — Environment Variables
# Copy this file to .env and fill in every value.
# NEVER commit .env to version control.

# ── Memory (ChromaDB — no Docker needed) ─────────────────────────────────────
# Directory where ChromaDB persists the long-term vector store.
# Created automatically on first run.
#CHROMA_PATH=./chroma_data

# SQLite file for LangGraph session checkpointing.
# Created automatically on first run.
#SQLITE_CHECKPOINT_PATH=./beaver_memory.sqlite

# Ollama model used for long-term memory embeddings.
# Must be pulled: ollama pull nomic-embed-text
#EMBEDDING_MODEL=nomic-embed-text

# GPU layers for the EMBEDDING model specifically (independent of
# OLLAMA_NUM_GPU below, which is for the main chat model). Defaults to 0 —
# CPU-only — so the embed model never competes with the chat model for
# VRAM on tight-VRAM cards (e.g. a 4GB laptop 3050). Set to -1 to let
# Ollama auto-decide instead, if you have VRAM to spare for both models
# resident at once.
#EMBEDDING_NUM_GPU=0

# ── Model ─────────────────────────────────────────────────────────────────────

#MODEL_NAME=llama3.2:3b-instruct-q4_K_M
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_NUM_CTX=16384

# GPU layers for the main chat model. Defaults to -1 (let Ollama
# auto-decide). Set a specific integer to force a fixed number of layers
# on GPU, e.g. if auto-detection picks a value that doesn't fit your VRAM.
#OLLAMA_NUM_GPU=99

# CPU threads for the main chat model. Defaults to this machine's CPU
# count (os.cpu_count(), or 4 if that can't be determined).
#OLLAMA_NUM_THREAD=12

# Prompt-processing batch size for the main chat model. Defaults to 256.
#OLLAMA_NUM_BATCH=256

# How long Ollama keeps the model loaded in memory after the last request
# before unloading it. Defaults to "10m". Accepts Ollama's duration
# strings (e.g. "5m", "1h"), or "-1" to keep it loaded indefinitely.
#OLLAMA_KEEP_ALIVE=10m

# Low-VRAM mode for the main chat model — trades speed for a smaller
# memory footprint. Defaults to false.
#OLLAMA_LOW_VRAM=True

# ── Agent ─────────────────────────────────────────────────────────────────────
#AGENT_MAX_LOOPS=16

# ── Langfuse (optional — cloud tracing, zero containers) ─────────────────────
# Sign up free at https://cloud.langfuse.com, create a project, copy keys.
# Leave blank to disable tracing entirely.
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_HOST=https://cloud.langfuse.com

# ── A2A Sub-Agent Roster ──────────────────────────────────────────────────────
# Define which local Ollama models become sub-agents.
# If left empty, ALL pulled Ollama models are auto-registered.
#
#A2A_AGENTS=[
#  {"name":"coder",      "persona":"coder",      "model":"qwen2.5-coder:3b-instruct-q4_K_M"},
#  {"name":"researcher", "persona":"researcher", "model":"llama3.2:3b-instruct-q4_K_M"},
#  {"name":"seo",        "persona":"seo",         "model":"qwen2.5:3b-instruct-q4_K_M"}
#]

# Timeout in seconds before a sub-agent call is cancelled (default: 120)
#A2A_TIMEOUT=300

# Max concurrent Ollama model loads during a2a_broadcast (default: 2)
#A2A_MAX_CONCURRENT=2

# ── MCP Servers ───────────────────────────────────────────────────────────────
# JSON must be on ONE line — python-dotenv does not support multiline values.
#
# Zero-API-key servers (recommended starting set):
#   filesystem            — npx, from @modelcontextprotocol/server-filesystem
#   git                    — uvx, from mcp-server-git (needs `uv` installed:
#                            https://docs.astral.sh/uv/getting-started/installation/)
#   fetch                  — uvx, from mcp-server-fetch (reads/pulls web pages)
#                            pin `--with mcp<2.0` — mcp-server-fetch is broken
#                            by the mcp 2.0.0 SDK's McpError→MCPError rename
#                            (upstream issue: modelcontextprotocol/servers#4560)
#   time                   — uvx, from mcp-server-time (timezone/date utils)
#                            same `--with mcp<2.0` pin needed, same reason
#   sequential-thinking    — npx, from @modelcontextprotocol/server-sequential-thinking
#   chroma                 — uvx, from chroma-mcp (official Chroma team server).
#                            Points at Beaver's own chroma_data dir (CHROMA_PATH)
#                            so you can inspect long-term memory directly:
#                            list/peek/count collections, get documents by
#                            id/filter. Semantic query_documents may not work
#                            correctly since Beaver's collection uses a custom
#                            Ollama embedding function chroma-mcp doesn't know
#                            about — inspection tools are unaffected.
#   sqlite                 — uvx, from mcp-server-sqlite (also modelcontextprotocol/servers —
#                            pinned mcp<2.0 defensively, same rename bug as fetch/time).
#                            Points at beaver_memory.sqlite (LangGraph checkpoint DB).
#                            Tools: list_tables, describe_table, read_query.
#   context7               — npx, from @upstash/context7-mcp. Free, no API key
#                            needed for basic use. Fetches live, version-specific
#                            library docs instead of relying on training data —
#                            directly targets hallucinated APIs for the coder persona.
#
#MCP_SERVERS=[{"name":"filesystem","cmd":["npx","-y","@modelcontextprotocol/server-filesystem","C:/path/to/allow"],"persona":"*"},{"name":"git","cmd":["uvx","mcp-server-git","--repository","C:/path/to/repo"],"persona":"*"},{"name":"fetch","cmd":["uvx","--with","mcp<2.0","mcp-server-fetch"],"persona":"*"},{"name":"time","cmd":["uvx","--with","mcp<2.0","mcp-server-time"],"persona":"*"},{"name":"sequential-thinking","cmd":["npx","-y","@modelcontextprotocol/server-sequential-thinking"],"persona":"*"},{"name":"chroma","cmd":["uvx","chroma-mcp","--client-type","persistent","--data-dir","C:/path/to/repo/chroma_data"],"persona":"*"},{"name":"sqlite","cmd":["uvx","--with","mcp<2.0","mcp-server-sqlite","--db-path","C:/path/to/repo/beaver_memory.sqlite"],"persona":"*"},{"name":"context7","cmd":["npx","-y","@upstash/context7-mcp"],"persona":"*"}]

# GitHub MCP — add once you have a token (Settings → Developer settings →
# Personal access tokens → fine-grained, scoped to only the repos you need).
# Official remote server (no local process to run):
#MCP_SERVERS=[...,{"name":"github","url":"https://api.githubcopilot.com/mcp/","headers":{"Authorization":"Bearer YOUR_GITHUB_TOKEN"},"persona":"*"}]

#MCP_CONNECT_TIMEOUT=30

# ── Plugin: structured_notes ──────────────────────────────────────────────────
# Directory where the notes_* tools (available to every persona) read and
# write per-thread note files. Defaults to "./notes", created on first use.
#BEAVER_NOTES_DIR=./notes


# ── Plugin: web search ────────────────────────────────────────────────────────
#TAVILY_API_KEY=tvly-...
#BRAVE_API_KEY=BSA...


# ── Beaver Web Token ────────────────────────────────────────────────────────
# Shared-secret gate for the web UI (index page + /ws WebSocket). Unset by
# default so `python web/server.py` on localhost keeps working with zero
# setup. The moment you bind this to 0.0.0.0 or expose it on any network
# beyond your own machine, set this — without it, anyone who can reach the
# port has full access to Beaver, including os_exec on the coder/pentester/
# orchestrator personas.
#
# Generate a value with:
#   openssl rand -hex 32
# (Windows without WSL/Git Bash: `python -c "import secrets; print(secrets.token_hex(32))"`)
#
# The web UI will prompt you to enter this token the first time it can't
# authenticate — it's typed into the app itself and kept in the browser's
# sessionStorage, never put in the URL, so it won't end up in your browser
# history, this server's access logs, or a Referer header.
#BEAVER_WEB_TOKEN=
